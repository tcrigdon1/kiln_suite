  "description": "Kiln Suite — Gesso (layered image editor) and Cutline (multitrack video editor). Plain JavaScript, runs from a folder in Chrome or Edge, no build step.",
  "private": true,
  "license": "MIT",
  "author": "Thomas Rigdon",
  "repository": { "type": "git", "url": "https://github.com/tcrigdon1/kiln_suite.git" },
